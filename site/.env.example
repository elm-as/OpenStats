# Cle secrete SasPay (sk_test_... en essai, sk_live_... en production).
SASPAY_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Secret de signature du webhook, communique une seule fois a la creation
# de l'endpoint dans le tableau de bord SasPay. Sans lui, aucune notification
# de paiement n'est acceptee.
SASPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Secret de signature des cles de licence. Le changer invalide toutes les
# licences deja emises : a generer une fois, puis a conserver.
# openssl rand -base64 48
LICENCE_SECRET=

# Secret de signature des jetons d'activation machine.
ACTIVATION_SECRET=

# URL publique du site, utilisee pour construire l'adresse de retour du paiement.
SITE_URL=http://localhost:4000

# Adresse du programme d'installation, servi par un stockage externe.
URL_INSTALLEUR=

# Envoi des cles par courriel. Sans cette cle, la licence est enregistree mais
# le client doit la recuperer dans son espace.
RESEND_API_KEY=
COURRIEL_EXPEDITEUR=OpenStats <licences@openstats.app>
