{
  "name": "openstats",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "electron:start": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:desktop": "tsc -b && vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.elmaslabs.openstats",
    "productName": "OpenStats Desktop",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../backend/dist/openstats-backend",
        "to": "openstats-backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/vite.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenStats Desktop"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@reduxjs/toolkit": "^2.2.0",
    "@types/plotly.js": "^3.0.10",
    "@xyflow/react": "^12.11.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.370.0",
    "plotly.js": "^3.5.1",
    "plotly.js-dist-min": "^3.5.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-dropzone": "^14.2.0",
    "react-plotly.js": "^2.6.0",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.23.0",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  }
}
